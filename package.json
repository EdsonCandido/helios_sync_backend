{
	"name": "sync-backend",
	"version": "1.0.0",
	"description": "Sync Backend API",
	"main": "dist/index.js",
	"scripts": {
		"dev": "tsx watch src/server.ts --ignore-watch node_modules/**",
		"build": "tsc",
		"start": "node dist/index.js",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"knex": "tsx ./node_modules/knex/bin/cli.js --knexfile src/database/knexfile.ts",
		"migrate:latest": "npm run knex -- migrate:latest",
		"migrate:rollback": "npm run knex -- migrate:rollback",
		"migrate:make": "npm run knex -- migrate:make",
		"seed:run": "npm run knex -- seed:run",
		"seed:make": "npm run knex -- seed:make"
	},
	"dependencies": {
		"bcryptjs": "^3.0.3",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"helmet": "^8.1.0",
		"http-status-codes": "^2.3.0",
		"jose": "^6.2.3",
		"knex": "^3.2.10",
		"pg": "^8.20.0",
		"pino": "^10.3.1",
		"pino-http": "^11.0.0",
		"uuid": "^14.0.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@types/bcryptjs": "^2.4.6",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^25.7.0",
		"@types/pino-http": "^5.8.4",
		"@types/uuid": "^10.0.0",
		"pino-pretty": "^13.1.3",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3"
	}
}
